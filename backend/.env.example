# Application
APP_NAME=Wildfire Damage Assessment Platform
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Backend
BACKEND_URL=http://localhost:8000
API_V1_STR=/api/v1

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wildfire_db
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET=wildfire-data

# Sentinel Hub
SENTINEL_HUB_CLIENT_ID=your_client_id
SENTINEL_HUB_CLIENT_SECRET=your_client_secret

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
ALLOWED_HOSTS=["localhost", "127.0.0.1"]

# File uploads
MAX_UPLOAD_SIZE_MB=500
UPLOAD_DIR=uploads/
TEMP_DATA_DIR=temp/

# Models
YOLO_BUILDING_MODEL_PATH=ml_models/building_detector.pt
DAMAGE_CLASSIFIER_PATH=ml_models/damage_classifier.pt
